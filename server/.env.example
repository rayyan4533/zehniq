# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"
BETTER_AUTH_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
BETTER_AUTH_URL="http://localhost:8081"
CLIENT_URL="http://localhost:3000"
PORT=8081

# Mem0 Platform user memory: create a key at https://app.mem0.ai
MEM0_API_KEY=""

# Local background worker configuration. Start the Inngest dev server separately.
INNGEST_DEV=1
# For hosted Inngest, unset INNGEST_DEV and configure:
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=
