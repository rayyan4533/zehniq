# ==============================================================================
# ChaiBook Environment Variables Configuration
# Copy this file to .env and replace the placeholder values with your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# Server Configuration
# ------------------------------------------------------------------------------
PORT=8081
NODE_ENV=development
CLIENT_URL=http://localhost:3001

# ------------------------------------------------------------------------------
# Database (PostgreSQL with pgvector)
# Matches docker-compose.yml configuration (Host port: 5435)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5435/chaibook?schema=public

# ------------------------------------------------------------------------------
# Authentication (Better Auth)
# Generate a secure 32+ char secret: openssl rand -base64 32
# ------------------------------------------------------------------------------
BETTER_AUTH_URL=http://localhost:8081
BETTER_AUTH_SECRET=your_better_auth_secret_key_here_min_32_chars

# Google OAuth (Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ------------------------------------------------------------------------------
# AI & Vector Storage
# ------------------------------------------------------------------------------
# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# Pinecone Vector Database (https://app.pinecone.io)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=chaibook

# Mem0 User Memory (https://app.mem0.ai)
MEM0_API_KEY=m0-your_mem0_api_key_here

# ------------------------------------------------------------------------------
# Web Search & Web Scraping
# ------------------------------------------------------------------------------
# Tavily Search API (https://tavily.com)/+ firecrawl
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# Firecrawl Web Scraper (https://firecrawl.dev)
FIRECRAWL_API_KEY=fc-your_firecrawl_api_key_here

# ------------------------------------------------------------------------------
# Media Storage (Cloudinary)
# https://console.cloudinary.com/
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# Cloudinary unsigned upload preset (Settings -> Upload -> Upload presets)
CLOUDINARY_UPLOAD_PRESET=dt2jgaj48

# ------------------------------------------------------------------------------
# Background Tasks (Inngest) - Optional for local development
# Local dev server runs via: npx inngest-cli@latest dev -u http://localhost:8081/api/inngest
# ------------------------------------------------------------------------------
# INNGEST_EVENT_KEY=your_inngest_event_key
# INNGEST_SIGNING_KEY=your_inngest_signing_key
